# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nerdyos

# JWT secret for auth tokens (required)
JWT_SECRET=your-super-secret-key-here

# Port (Render sets this automatically, default 5000 for local dev)
PORT=5000

# Frontend URL for CORS (set to your Vercel deployment URL)
FRONTEND_URL=https://nerdyos.vercel.app

# Node environment
NODE_ENV=production
