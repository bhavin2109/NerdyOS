# ══════════════════════════════════════════════
# NerdyOS Backend .gitignore
# ══════════════════════════════════════════════

# ─── Dependencies ────────────────────────────
node_modules/

# ─── Environment Variables ───────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local
# NOTE: .env.example is safe to commit (template only)

# ─── Logs ────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Runtime Data ────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ─── Build Output ────────────────────────────
dist/

# ─── OS Files ────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editors / IDEs ─────────────────────────
.vscode/
.idea/
*.sw?
*.swp
*.swo

# ─── Testing / Coverage ─────────────────────
coverage/
.nyc_output/
